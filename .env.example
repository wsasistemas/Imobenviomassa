# Cliente (embutidas no bundle no momento do build — são públicas)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Servidor (server functions / SSR)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>
SUPABASE_PROJECT_ID=<project-ref>
# Secreta — NUNCA versionar. O .env está no .gitignore (confira com `git ls-files .env`: não deve
# aparecer). Na Vercel: Settings → Environment Variables (Production), sem prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# Origem pública do portal (sem barra final). Usada no returnUrl/frameAncestors do preview DocuSign.
APP_URL=https://<dominio-do-portal>
# Opcional: hosts permitidos para o endpoint do TOTVS RM (separados por vírgula). Sem isso, exige o mesmo host já cadastrado.
RM_HOSTS_PERMITIDOS=

# TOTVS RM: as credenciais ficam no banco (Administração → Integrações → TOTVS RM), não aqui.

# Domínios de e-mail aceitos no cadastro de usuários (separados por vírgula). Padrão: calper.com.br. "*" libera todos.
EMAIL_DOMINIOS_PERMITIDOS=calper.com.br
